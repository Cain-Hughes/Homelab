# Populate .env on the host; never commit its values.
PUID=1000
PGID=1000
TZ=America/New_York
# Complete provider-specific settings using your own Gluetun configuration.
VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_PORT_FORWARDING=on
# Dedicated keys for Unpackerr. Decluttarr uses its own local YAML.
SONARR_API_KEY=
RADARR_API_KEY=
